# .htaccess - SIMPLIFIED VERSION for troubleshooting
# If this causes 500 error, rename to .htaccess.bak and delete original .htaccess

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /dollar-tree-platform/
</IfModule>

# Prevent directory browsing
Options -Indexes

# PHP settings (remove if causes error)
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Allow .php files
<FilesMatch "\.php$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
